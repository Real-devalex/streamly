# ─────────────────────────────────────────────────────────────
# Streamly — environment variables
# Copy this file to `.env` and fill in your Supabase project keys.
# Without these values the app boots in DEMO MODE (mock data,
# mock auth) so the UI stays fully explorable.
#
# On Vercel, set these in Project → Settings → Environment Variables.
# Build output is `dist`; rewrites are handled in vercel.json.
# ─────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_TMDB_API_KEY=your-tmdb-api-key
VITE_APP_NAME=Streamly
VITE_APP_URL=http://localhost:5173
